# GL-MT6000 包编译最小配置：只定目标 + 两个主包，依赖交给 make defconfig 解析。
# 注意：不要在这里手写完整 .config，也不要照抄别的树生成的完整 .config
# （MT3000 run6 的教训：跨树完整 .config 会被 make defconfig 以退出码 2 拒绝）。

CONFIG_TARGET_mediatek=y
CONFIG_TARGET_mediatek_mt7986=y
# 必须开 MULTI_PROFILE，否则单设备模式下上面这行设备选择会被
# make defconfig 丢掉、落到默认的 ax6000-spim-nor-rfb 配置上
# （本地已实测）。ipk 架构同为 aarch64_cortex-a53，包本身不受影响，
# 但为求配置与目标一致，这里把它补上。
CONFIG_TARGET_MULTI_PROFILE=y
CONFIG_TARGET_DEVICE_mediatek_mt7986_DEVICE_glinet_gl-mt6000=y
CONFIG_TARGET_DEVICE_PACKAGES_mediatek_mt7986_DEVICE_glinet_gl-mt6000=""

CONFIG_PACKAGE_apfree-wifidog=y
CONFIG_PACKAGE_luci-app-apfree-wifidog=y
